<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Supabase / Vercel API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- LAN 打印機掃描(LanScanner 讀 ARP + 9100/631/80 探測) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 藍牙打印(Android 6–11:BLUETOOTH/ADMIN 係安裝時 normal permission;
         12+ 先要 runtime BLUETOOTH_SCAN/CONNECT,打印引擎已按 SDK_INT 分流) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 6–11:startDiscovery() 系統硬性要求;冇就靜默回空結果 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- USB Host:外接 ESC/POS 打印機(required=false 令無 USB host 嘅機都裝到) -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MacauposNative"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USB_DEVICE_ATTACHED intent-filter 留返 P1 接打印機 wizard 嗰陣先加
                 (要配套 @xml/device_filter,而家未接 wizard 冇意義) -->
        </activity>

        <!-- 登入後第一頁:揀工作台(對齊 web SelectWorkbenchScreen) -->
        <activity
            android:name=".WorkbenchActivity"
            android:exported="false" />

        <activity
            android:name=".OrderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TablesActivity"
            android:exported="false" />

        <activity
            android:name=".OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ShiftActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SoldOutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReportActivity"
            android:exported="false" />

        <activity
            android:name=".MenuAdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnlineOrdersActivity"
            android:exported="false" />

        <!-- 訂單頁(/orders = web OrdersHub):左線上 + 右線下 -->
        <activity
            android:name=".OrdersActivity"
            android:exported="false" />

        <activity
            android:name=".DeliveryActivity"
            android:exported="false" />

        <activity
            android:name=".PrintCenterActivity"
            android:exported="false" />

        <activity
            android:name=".StaffActivity"
            android:exported="false" />

        <activity
            android:name=".MemberLookupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".KdsActivity"
            android:exported="false" />

        <activity
            android:name=".PrintTemplatesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PrinterWizardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SyncHealthActivity"
            android:exported="false" />

        <activity
            android:name=".InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
