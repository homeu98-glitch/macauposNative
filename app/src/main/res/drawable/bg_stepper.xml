<?xml version="1.0" encoding="utf-8"?>
<!-- 步進按鈕(web: h-10 w-10 rounded-full border-slate-200 bg-white) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/slate_50" />
            <stroke android:width="1dp" android:color="@color/text_faint" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
