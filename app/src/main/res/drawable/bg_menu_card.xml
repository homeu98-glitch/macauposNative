<?xml version="1.0" encoding="utf-8"?>
<!-- 菜品卡 pressed 變色(ripple 用 selector 包 shape) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
