<?xml version="1.0" encoding="utf-8"?>
<!-- 購物車行(web: rounded-2xl border-slate-100 bg-slate-50) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/orange_50" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/slate_50" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
