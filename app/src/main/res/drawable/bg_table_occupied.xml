<?xml version="1.0" encoding="utf-8"?>
<!-- 有單桌卡(orange-50 底 + orange-300 邊) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FED7AA" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_border" />
        </shape>
    </item>
</selector>
