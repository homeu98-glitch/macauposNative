<?xml version="1.0" encoding="utf-8"?>
<!-- 左側導軌(1:1 對齊 web AppSidebar):
     圓形短字徽章(bg-white/10) + 短 label;選中 bg-orange-500 白字;未選 bg-slate-800 slate-200 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="72dp"
    android:layout_height="match_parent"
    android:background="@color/rail_bg"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingTop="8dp">

    <!-- POS 標記 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_rail_active"
        android:gravity="center"
        android:text="POS"
        android:textColor="@color/card"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- ═══ 9 個模組(順序=web module-catalog 單一真源)═══ -->

    <LinearLayout
        android:id="@+id/railOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="點"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="點餐"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="單"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="訂單"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railDelivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="送"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="外送"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railMember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="會"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="會員"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railPrint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="印"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="打印"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="報"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="報表"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railSoldout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="沽"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="沽清"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railShift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="班"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="交班"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/railInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_rail_icon"
            android:gravity="center"
            android:text="庫"
            android:textColor="@color/rail_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="庫存"
            android:textColor="@color/rail_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ═══ 底部:店名卡 + 在線 + 登出(對齊 web)═══ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/railStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="2dp"
            android:text="門店"
            android:textColor="@color/rail_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/railStoreRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="店舖"
            android:textColor="@color/rail_text"
            android:textSize="8sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/railOnline"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center"
        android:text="在線"
        android:textColor="@color/ok_green"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/railLogout"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rail_item"
        android:gravity="center"
        android:text="登出"
        android:textColor="@color/rail_text"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
