<?xml version="1.0" encoding="utf-8"?>
<!-- 快餐底部「線上訂單 / 線下訂單」兩窗(對齊 web QuickModeOrdersBar):
     左=線上訂單(接單開關+待處理線上單橫向strip) | 右=線下訂單(營業中+線下單橫向strip) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:orientation="horizontal">

    <!-- 線上訂單 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="線上訂單"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOnlineToggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_pill_light"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="線上接單"
                android:textColor="@color/ok_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtOnlineEmpty"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="暫無待處理線上訂單。"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOnlineStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/card_border" />

    <!-- 線下訂單 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="線下訂單"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLocalToggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_pill_on_solid"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="營業中"
                android:textColor="@color/card"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLocalEmpty"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="暫無線下訂單。"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLocalStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
