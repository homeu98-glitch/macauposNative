<?xml version="1.0" encoding="utf-8"?>
<!-- 菜品卡(web: min-h-36 rounded-2xl border bg-white p-4;右上 xN 橙角標;
     底部 價錢(slate-900 16px semibold)+「加入」橙藥丸) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_menu_card"
        android:minHeight="130dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="菜品名"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MOP0.00"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_add_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="加入"
                android:textColor="@color/orange_600"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="7dp"
        android:background="@drawable/bg_badge_count"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="x1"
        android:textColor="@color/card"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
